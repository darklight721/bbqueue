# Copy to .env.local. The Firebase web config is public by design (Security Rules protect the data).
# Without any of these the app runs exactly as before: no Accounts, no Welcome screen.

# Firebase backend (Anonymous Auth + Firestore). API key, project id and app id are required.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (optional, but enforce App Check in production).
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# `fake` uses a local fake backend persisted in localStorage (Playwright e2e, local dev).
# Takes precedence over the Firebase variables.
# VITE_BACKEND=fake

# `1` runs the Firebase backend on the local emulators (`pnpm emulators`, needs Java): no
# Firebase project and no config above needed. Used by the two-person e2e specs.
# VITE_FIREBASE_EMULATOR=1
