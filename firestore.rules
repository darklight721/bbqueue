rules_version = '2';

// Security Rules (ADR-0006, ADR-0007, ADR-0010). Tested on the Firebase emulator:
// src/backend/firestore.rules.emulator.test.ts (`pnpm test:firebase`).
//
// Data (see src/backend/firebaseBackend.ts and firebaseClubs.ts):
// accounts/{uid} { accountId, name, createdAt }
// accountIds/{normalised id} { uid } reserves an Account ID for good
// clubs/{clubId} { name, memberUids, organizerUids, createdAt, joinToken? }
// clubs/{clubId}/players/{playerId} { name, skill, link?: { accountId, uid, role } }
// clubs/{clubId}/activeSession/current
// { sessionId, sessionJson, hostUid, hostAccountId, hostName, updatedAt }
// clubs/{clubId}/activeSession/current/requests/{requestId}
// { uid, accountId, sessionId, sessionPlayerId, kind, createdAt }
// clubs/{clubId}/endedSessions/{sessionId}
// { hostUid, endedAt, endedJson, createdAt }
// joinLinks/{token} { clubId, clubName, createdAt } the Join record of a Club's Join link
// joinLinks/{token}/names/{nameHash} { playerId, linked } one per Club player, linked ones too
// joinLinks/{token}/claims/{uid} { clubId, playerId, createdAt } who Claimed which row
//
// The Active session of a Shared club is one fixed record, so a Club has at most one. It holds the
// Session host's whole Session (as JSON text) and who the host is; see the rules at the end.
//
// A person is their Firebase `uid`; the readable Account ID is how others find them. A Club
// player row is the truth about who is linked and with which Role. `memberUids` and
// `organizerUids` are an index derived from the rows' links: they let an Account list its Clubs
// and let these rules see who may read and write without scanning rows or reading `accounts`.
// Every write that links, unlinks or changes a Role must update the index in the same batch as
// the row; the rules below check the index as it will be after the batch (`getAfter`).
//
// A link names the Account ID (for display) and the uid. The rules accept it only when
// `accountIds/{id}` says that uid owns that Account ID. Reservations are never overwritten or
// deleted (an Account ID is never released), so that stays true for good.
//
// Roles: an Organizer may change the Club and its rows, link and unlink Accounts and change Roles.
// A Player may only read, and unlink themselves (leave). A Club keeps at least one Organizer.
//
// Not enforced here (the app does): that an Account is linked to one row only, and that the
// lists hold only uids that have a row. An Organizer can write any uid to the lists directly;
// that only gives that uid read access, and it takes knowing the uid.
//
// A new Club's first batch (ADR-0008): the creator is a member and Organizer, and the batch may
// also link other Accounts, with any Role. Each such row is checked like a later link: the Account
// ID is reserved by that uid and the lists, as they will be after the batch, agree with it.
//
// Join links (ADR-0010): the Club keeps its current `joinToken`, which Organizers set, each new
// token with a new Join record in the same batch. Holding the current token, anyone signed in may
// read the Join record (the Club's id and name) and look a name up in its index, one entry at a
// time (an old token's leftovers can't be read): `nameHash` is the hex SHA-256 of
// `token + ":" + joinNameKey(name)` (src/domain/joinLink.ts), and nobody may list the index, so a
// link holder can check a name but not read the roster. The index is derived data, like the
// lists: every write that adds, renames, removes, links or unlinks a row, or renames the Club,
// updates it in the same batch (Not enforced here: the rules can't hash). A Claim is one batch by
// an Account that isn't on the Club: its claim record under the Club's *current* token, the link
// on a row that had none (as Player), its uid added to `memberUids`, and the name's entry marked
// linked. Resetting the link changes `joinToken`, so records left under an old token are inert.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A name (Account, Club or Club player): not empty, at most 40 characters, and without control,
    // bidi or zero-width characters (Unicode category C), which can't be seen and can make a name
    // look like another. The app trims it first, strips the same characters and uses the same
    // maximum (`normalizeName` and MAX_NAME_LENGTH in src/domain/validation.ts).
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 40
        && !name.matches('.*\\p{C}.*');
    }

    // --- Accounts -------------------------------------------------------------------------

    // Anyone signed in can look an Account up (to see its name when they have its Account ID), but
    // only its owner can write it. It must have been reserved in the same write, its Account ID
    // never changes and only its name can.
    match /accounts/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['accountId', 'name', 'createdAt'])
        && request.resource.data.keys().hasAll(['accountId', 'name', 'createdAt'])
        && request.resource.data.accountId is string
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/accountIds/$(request.resource.data.accountId.lower())).data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Account-ID records are created once, by their owner, together with the Account, and then
    // never change or go away: the Account ID can never be reserved again, not even after its
    // Account is deleted. A person reserves one Account ID. They can be read one at a time, never
    // listed.
    match /accountIds/{accountId} {
      allow get: if signedIn();
      allow create: if signedIn()
        && accountId == accountId.lower()
        && accountId.size() <= 40
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.accountId.lower() == accountId;
      allow update: if false;
      allow delete: if false;
    }

    // --- Shared clubs ---------------------------------------------------------------------

    match /clubs/{clubId} {
      function clubPath() {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      // The Club as it is now / as it will be once this write or batch is done.
      function before() {
        return get(clubPath()).data;
      }
      function after() {
        return getAfter(clubPath()).data;
      }

      // Only Accounts linked to the Club can read it (a Club that isn't there reads as empty).
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberUids);
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Anyone signed in with an Account can create a Club, as a member and Organizer. The lists
      // may already name other Accounts (ADR-0008); each one needs a row in the same batch that
      // links it (see the players' create rule). Organizers are members. The creation time is the
      // server's: the creator's one-hour window to import history (see Ended sessions) can't be
      // held open by choosing a date.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['name', 'memberUids', 'organizerUids', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'memberUids', 'organizerUids', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.memberUids is list
        && request.resource.data.organizerUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid in request.resource.data.organizerUids
        && request.resource.data.memberUids.toSet().hasAll(request.resource.data.organizerUids)
        && request.resource.data.createdAt == request.time;

      // The claim record of a Claim by this Account under the Club's current Join link, as it
      // will be after the batch.
      function claimAfter() {
        return getAfter(/databases/$(database)/documents/joinLinks/$(before().joinToken)/claims/$(request.auth.uid)).data;
      }

      // An Organizer may rename the Club, change who is a member or Organizer (the rows say who,
      // see above), as long as an Organizer is left and Organizers are members, and set its Join
      // link's token.
      allow update: if signedIn()
        && (
          (
            request.auth.uid in resource.data.organizerUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberUids', 'organizerUids', 'joinToken'])
            && validName(request.resource.data.name)
            && request.resource.data.organizerUids.size() > 0
            && request.resource.data.memberUids.toSet().hasAll(request.resource.data.organizerUids)
            && (
              request.resource.data.get('joinToken', null) == resource.data.get('joinToken', null)
              || !('joinToken' in request.resource.data)
              // A new token gets its own new Join record in the same batch: a Club can't take
              // over a record that is already there (an old Club's, or another Club's).
              || (
                request.resource.data.joinToken.matches('[A-Za-z0-9_-]{22}')
                && !exists(/databases/$(database)/documents/joinLinks/$(request.resource.data.joinToken))
                && existsAfter(/databases/$(database)/documents/joinLinks/$(request.resource.data.joinToken))
              )
            )
          )
          // Somebody who isn't on the Club Claims a row (see the rows' update rule): they add
          // themselves to the members, and nothing else.
          || (
            !(request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
            && claimAfter().clubId == clubId
            && getAfter(/databases/$(database)/documents/clubs/$(clubId)/players/$(claimAfter().playerId)).data.link.uid == request.auth.uid
          )
          // Anyone on the Club may take themselves off the lists (leave), and only themselves.
          || (
            request.auth.uid in resource.data.memberUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'organizerUids'])
            && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.organizerUids.toSet() == resource.data.organizerUids.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.organizerUids.size() > 0
          )
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.organizerUids;

      // One record per Club player.
      match /players/{playerId} {
        function validRow(row) {
          return row.keys().hasOnly(['name', 'skill', 'link'])
            && validName(row.name)
            && row.skill in ['beginner', 'intermediate', 'advanced']
            && (!('link' in row)
              || (row.link.keys().hasOnly(['accountId', 'uid', 'role'])
                  && row.link.keys().hasAll(['accountId', 'uid', 'role'])
                  && row.link.accountId is string
                  && row.link.uid is string
                  && row.link.role in ['organizer', 'player']));
        }

        // The uid in a link is the one that owns the link's Account ID.
        function linkIsReserved(link) {
          return get(/databases/$(database)/documents/accountIds/$(link.accountId.lower())).data.uid == link.uid;
        }

        // A link is only valid when the Club's lists, after this batch, agree with it.
        function linkAgreesWithClub(link) {
          return linkIsReserved(link)
            && link.uid in after().memberUids
            && ((link.role == 'organizer') == (link.uid in after().organizerUids));
        }

        // The Account a row was linked to must be off the lists after the batch unless the row
        // is still linked to it.
        function oldLinkAgreesWithClub(oldRow, newRow) {
          return !('link' in oldRow)
            || ('link' in newRow && newRow.link.uid == oldRow.link.uid)
            || !(oldRow.link.uid in after().memberUids);
        }

        allow read: if signedIn() && request.auth.uid in before().memberUids;

        // A new Club's first rows are written in the same batch as the Club, by its creator (an
        // Organizer after the batch), who may link any Account with any Role (ADR-0008), each link
        // checked like a later one. Otherwise only an Organizer adds rows.
        allow create: if signedIn()
          && validRow(request.resource.data)
          && (
            (
              !exists(clubPath())
              && request.auth.uid in after().organizerUids
              && (!('link' in request.resource.data) || linkAgreesWithClub(request.resource.data.link))
            )
            || (
              exists(clubPath())
              && request.auth.uid in before().organizerUids
              && after().organizerUids.size() > 0
              && (!('link' in request.resource.data) || linkAgreesWithClub(request.resource.data.link))
            )
          );

        // An Organizer edits rows, links and unlinks Accounts and changes Roles. A linked Account
        // may unlink only itself, leaving the rest of the row as it was. Either way an Organizer
        // is left.
        allow update: if signedIn()
          && validRow(request.resource.data)
          && after().organizerUids.size() > 0
          && (
            (
              request.auth.uid in before().organizerUids
              && (!('link' in request.resource.data) || linkAgreesWithClub(request.resource.data.link))
              && oldLinkAgreesWithClub(resource.data, request.resource.data)
            )
            || (
              request.auth.uid in before().memberUids
              && 'link' in resource.data
              && resource.data.link.uid == request.auth.uid
              && !('link' in request.resource.data)
              && request.resource.data.name == resource.data.name
              && request.resource.data.skill == resource.data.skill
              && !(request.auth.uid in after().memberUids)
            )
            // A Claim through the Club's current Join link (ADR-0010): somebody who wasn't on the
            // Club links themselves, as Player, to a row that had no link, leaving the rest of the
            // row as it was, with a claim record for this row in the same batch.
            || (
              !(request.auth.uid in before().memberUids)
              && !('link' in resource.data)
              && 'link' in request.resource.data
              && request.resource.data.link.uid == request.auth.uid
              && request.resource.data.link.role == 'player'
              && linkAgreesWithClub(request.resource.data.link)
              && request.resource.data.name == resource.data.name
              && request.resource.data.skill == resource.data.skill
              && claimAfter().clubId == clubId
              && claimAfter().playerId == playerId
            )
          );

        // Only an Organizer removes rows (a linked Account leaves by unlinking), keeping an
        // Organizer and the lists in step. Deleting the whole Club clears its rows too.
        allow delete: if signedIn()
          && request.auth.uid in before().organizerUids
          && (
            !existsAfter(clubPath())
            || (
              after().organizerUids.size() > 0
              && (!('link' in resource.data) || !(resource.data.link.uid in after().memberUids))
            )
          );
      }

      // The Active session (ADR-0007): the Session host's whole Session, kept in one fixed record
      // so a Club can have at most one (creating needs that no record exists yet).
      //
      // - Read: anyone on the Club (`memberUids`).
      // - Create: an Organizer, naming themselves as the host. Their Account ID must be the one
      // reserved for their uid, so the host's name on screen can't be somebody else's. It also
      // records the Session's id (`sessionId`), which never changes: the Ended session of this
      // Session must be named by it.
      // - Update: the host (`hostUid`) replaces the Session text and the time. `hostUid`,
      // `hostAccountId` and `hostName` can't change in that clause (nor can `sessionId`).
      // - Take over: an Organizer of the Club may make themselves the host, changing only the host
      // fields and the time.
      // - Delete: only the host, or an Organizer while the whole Club is being deleted.
      //
      // Updates, the most frequent writes in the app, decide from the record alone, with no extra
      // reads. So a host who loses the Organizer Role, or who leaves the Club, may keep uploading
      // until somebody takes over: deliberate, because the host's device is the source of truth
      // and a half-finished night shouldn't be cut off by a Role change.
      match /activeSession/{docId} {
        // The Session is JSON text; a Session takes about 40-100 KB and a record may not pass 1 MB.
        function validSessionJson(text) {
          return text is string && text.size() > 0 && text.size() <= 700000;
        }

        allow read: if signedIn() && request.auth.uid in before().memberUids;

        allow create: if signedIn()
          && docId == 'current'
          && request.auth.uid in before().organizerUids
          && request.resource.data.keys().hasOnly(['sessionId', 'sessionJson', 'hostUid', 'hostAccountId', 'hostName', 'updatedAt'])
          && request.resource.data.keys().hasAll(['sessionId', 'sessionJson', 'hostUid', 'hostAccountId', 'hostName', 'updatedAt'])
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.sessionId.size() <= 100
          && validSessionJson(request.resource.data.sessionJson)
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.hostAccountId is string
          && get(/databases/$(database)/documents/accountIds/$(request.resource.data.hostAccountId.lower())).data.uid == request.auth.uid
          && validName(request.resource.data.hostName)
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && (
            // The host uploads the latest copy.
            (
              resource.data.hostUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionJson', 'updatedAt'])
              && validSessionJson(request.resource.data.sessionJson)
              && request.resource.data.updatedAt == request.time
            )
            // An Organizer of the Club takes over: they become the host, and nothing
            // else changes, not even the Session text. This is also how a host who left the Club
            // or lost the Role is replaced. The app does it in a transaction so two Organizers
            // taking over at once can't both win; rules can't tell a transaction from a plain
            // write, so they only keep the write to the host fields. Once it lands, the old
            // host's uploads and delete fail the clause above and below.
            || (
              request.auth.uid in before().organizerUids
              && resource.data.hostUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid', 'hostAccountId', 'hostName', 'updatedAt'])
              && request.resource.data.hostUid == request.auth.uid
              && get(/databases/$(database)/documents/accountIds/$(request.resource.data.hostAccountId.lower())).data.uid == request.auth.uid
              && validName(request.resource.data.hostName)
              && request.resource.data.updatedAt == request.time
            )
          );

        allow delete: if signedIn()
          && (
            resource.data.hostUid == request.auth.uid
            || (!existsAfter(clubPath()) && request.auth.uid in before().organizerUids)
          );

        // Players' requests: `clubs/{clubId}/activeSession/current/requests/{id}`, each
        // one `{ uid, accountId, sessionId, sessionPlayerId, kind, createdAt }`, later marked
        // `{ status: 'applied' | 'skipped', resolvedAt }` by the host.
        //
        // - Create: anyone on the Club (`memberUids`), only for themselves (their own uid and the
        // Account ID reserved for it), only while the Club has an Active session, with the
        // server's time. The rules can't look inside the Session, so they can't tell whether
        // `sessionPlayerId` is the requester's own Session player: the host's device checks that
        // against the Account copied onto the Session player at Start, and skips a request that
        // isn't theirs.
        // - Read: the requester (so a query for one's own requests passes), and the host.
        // - Update: only the Session host, once, to mark it applied or skipped. Because a request
        // belongs to the record, not to a host, a new host (take over) finds the pending ones.
        // - Delete: only the host (when it ends the Session, together with the record).
        match /requests/{requestId} {
          function sessionPath() {
            return /databases/$(database)/documents/clubs/$(clubId)/activeSession/$(docId);
          }
          function isSessionHost() {
            return get(sessionPath()).data.hostUid == request.auth.uid;
          }

          allow read: if signedIn() && (resource.data.get('uid', null) == request.auth.uid || isSessionHost());

          allow create: if signedIn()
            && docId == 'current'
            && exists(sessionPath())
            && request.auth.uid in before().memberUids
            && request.resource.data.keys().hasOnly(['uid', 'accountId', 'sessionId', 'sessionPlayerId', 'kind', 'createdAt'])
            && request.resource.data.keys().hasAll(['uid', 'accountId', 'sessionId', 'sessionPlayerId', 'kind', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.accountId is string
            && get(/databases/$(database)/documents/accountIds/$(request.resource.data.accountId.lower())).data.uid == request.auth.uid
            && request.resource.data.sessionId is string
            && request.resource.data.sessionId.size() <= 100
            && request.resource.data.sessionPlayerId is string
            && request.resource.data.sessionPlayerId.size() <= 100
            && request.resource.data.kind in ['sit-out', 'back-in', 'leave']
            && request.resource.data.createdAt == request.time;

          allow update: if signedIn()
            && isSessionHost()
            && !('status' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
            && request.resource.data.status in ['applied', 'skipped']
            && request.resource.data.resolvedAt == request.time;

          // Also an Organizer when the whole Club is being deleted (a Club's history goes with it).
          allow delete: if signedIn()
            && (
              isSessionHost()
              || (!existsAfter(clubPath()) && request.auth.uid in before().organizerUids)
            );
        }
      }

      // Ended sessions of the Club (ADR-0005): `{ hostUid, endedAt, endedJson, createdAt }`, one
      // record per Session, named by the Session's id. `endedJson` is the slimmed Ended session as
      // JSON text.
      //
      // - Read: anyone on the Club.
      // - Create: only (a) the Session host, in the batch that ends the Session: the Active session
      // is gone after the batch and the record is named by the Session id it holds (`sessionId`),
      // so a Session ends once and cannot be filled with invented history; or (b) a Club's
      // creator importing its history when a Local club is made shared: the Club's only member
      // and Organizer, within an hour of the Club being created (the server's time, see Club
      // create). Either way `endedAt` is a real time (not in the future, give or take clock
      // skew), so a record can't pin itself to the top of "the 50 most recent".
      // - Update: nobody.
      // - Delete: any Organizer. The app deletes a Club's history before the Club itself, so a
      // Club's id that is created again later has none of the old one. Rules can't count or list,
      // so they can't make that sure; they only make it possible.
      // - "The 50 most recent" is what the app lists (newest 50 by `endedAt`); older ones stay on
      // the server unlisted.
      match /endedSessions/{sessionId} {
        function sensibleEndedAt(endedAt) {
          return endedAt is int
            && endedAt >= 0
            && endedAt <= request.time.toMillis() + 300000;
        }

        allow read: if signedIn() && request.auth.uid in before().memberUids;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['hostUid', 'endedAt', 'endedJson', 'createdAt'])
          && request.resource.data.keys().hasAll(['hostUid', 'endedAt', 'endedJson', 'createdAt'])
          && request.resource.data.hostUid == request.auth.uid
          && sensibleEndedAt(request.resource.data.endedAt)
          && request.resource.data.endedJson is string
          && request.resource.data.endedJson.size() > 0
          && request.resource.data.endedJson.size() <= 400000
          && request.resource.data.createdAt == request.time
          && (
            (
              exists(/databases/$(database)/documents/clubs/$(clubId)/activeSession/current)
              && get(/databases/$(database)/documents/clubs/$(clubId)/activeSession/current).data.hostUid == request.auth.uid
              && get(/databases/$(database)/documents/clubs/$(clubId)/activeSession/current).data.get('sessionId', null) == sessionId
              && !existsAfter(/databases/$(database)/documents/clubs/$(clubId)/activeSession/current)
            )
            || (
              request.auth.uid in getAfter(clubPath()).data.organizerUids
              && getAfter(clubPath()).data.memberUids.size() == 1
              && getAfter(clubPath()).data.get('createdAt', null) != null
              && request.time < getAfter(clubPath()).data.createdAt + duration.value(1, 'h')
            )
          );

        allow update: if false;

        allow delete: if signedIn() && request.auth.uid in before().organizerUids;
      }
    }

    // --- Join links (ADR-0010) ------------------------------------------------------------

    // The Join record: which Club a Join link is for, and its name to show. Anyone signed in who
    // holds the token reads it while it is the Club's current one (a token that names no record
    // reads as missing); nobody lists the records. An Organizer of the Club creates it in
    // the batch that makes this token the Club's current one, keeps its name in step, and deletes
    // it (on a reset, or with the Club).
    match /joinLinks/{token} {
      function clubOf(clubId) {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      // Whether this is the current Join link of Club `clubId` (false, or an error, for a Club
      // that is gone).
      function currentFor(clubId) {
        return get(clubOf(clubId)).data.get('joinToken', null) == token;
      }

      allow get: if signedIn() && (resource == null || currentFor(resource.data.clubId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['clubId', 'clubName', 'createdAt'])
        && request.resource.data.keys().hasAll(['clubId', 'clubName', 'createdAt'])
        && request.resource.data.clubId is string
        && validName(request.resource.data.clubName)
        && request.resource.data.createdAt == request.time
        && request.auth.uid in get(clubOf(request.resource.data.clubId)).data.organizerUids
        && getAfter(clubOf(request.resource.data.clubId)).data.get('joinToken', null) == token;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubName'])
        && validName(request.resource.data.clubName)
        && request.auth.uid in get(clubOf(resource.data.clubId)).data.organizerUids;

      allow delete: if signedIn()
        && request.auth.uid in get(clubOf(resource.data.clubId)).data.organizerUids;

      function linkPath() {
        return /databases/$(database)/documents/joinLinks/$(token);
      }
      // The Club this Join record is for: as it is, or as it is being created in this batch.
      function joinClubId() {
        return exists(linkPath()) ? get(linkPath()).data.clubId : getAfter(linkPath()).data.clubId;
      }
      function rowPath(playerId) {
        return /databases/$(database)/documents/clubs/$(joinClubId())/players/$(playerId);
      }
      function organizerHere() {
        return request.auth.uid in get(clubOf(joinClubId())).data.organizerUids;
      }

      // The name index: one entry per Club player, named by the hash of its name (see the top).
      // Read one at a time, never listed, and only while the token is the Club's current one, so
      // entries left behind by a reset or a deleted Club say nothing. Organizers write it. Besides
      // them, the entry of a row changes only from unlinked to linked in a Claim of that row, and
      // from linked to unlinked when whoever is linked to the row unlinks themselves (leaves, or
      // deletes their Account).
      match /names/{nameHash} {
        function validEntry(entry) {
          return entry.keys().hasOnly(['playerId', 'linked'])
            && entry.keys().hasAll(['playerId', 'linked'])
            && entry.playerId is string
            && entry.linked is bool;
        }

        allow get: if signedIn() && exists(linkPath()) && currentFor(get(linkPath()).data.clubId);

        allow create: if signedIn() && validEntry(request.resource.data) && organizerHere();

        allow update: if signedIn()
          && validEntry(request.resource.data)
          && (
            organizerHere()
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linked'])
              && request.resource.data.linked == true
              && getAfter(/databases/$(database)/documents/joinLinks/$(token)/claims/$(request.auth.uid)).data.playerId == resource.data.playerId
              && getAfter(rowPath(resource.data.playerId)).data.link.uid == request.auth.uid
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linked'])
              && request.resource.data.linked == false
              && get(rowPath(resource.data.playerId)).data.link.uid == request.auth.uid
              && !('link' in getAfter(rowPath(resource.data.playerId)).data)
            )
          );

        allow delete: if signedIn() && organizerHere();
      }

      // A Claim's record, by the Account Claiming: only under the Club's current Join link, only
      // by somebody who wasn't on the Club, and only in the batch that links them to that row and
      // adds them to the members (see the Club and row rules, which check it). Written again on a
      // later Claim through the same link (after an Organizer unlinked the first one). Not read.
      match /claims/{uid} {
        function claimedClub() {
          return clubOf(request.resource.data.clubId);
        }

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['clubId', 'playerId', 'createdAt'])
          && request.resource.data.keys().hasAll(['clubId', 'playerId', 'createdAt'])
          && request.resource.data.clubId is string
          && request.resource.data.playerId is string
          && request.resource.data.createdAt == request.time
          && get(linkPath()).data.clubId == request.resource.data.clubId
          && get(claimedClub()).data.get('joinToken', null) == token
          && !(uid in get(claimedClub()).data.memberUids)
          && uid in getAfter(claimedClub()).data.memberUids
          && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)/players/$(request.resource.data.playerId)).data.link.uid == uid;
      }
    }
  }
}
